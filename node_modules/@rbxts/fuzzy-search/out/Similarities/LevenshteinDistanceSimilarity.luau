local TS = _G[script]
local Scores = TS.import(script, script.Parent.Parent, "Scores").Scores
--[[
	*
	 * Normalizes Levenshtein edit distance to a similarity score (0–1).
	 
]]
local function LevenshteinDistanceSimilarity(term, query)
	local maxLen = math.max(#term, #query)
	if maxLen == 0 then
		return 1
	end
	local distance = Scores.LevenshteinDistance(term, query)
	return 1 - distance / maxLen
end
return {
	LevenshteinDistanceSimilarity = LevenshteinDistanceSimilarity,
}
