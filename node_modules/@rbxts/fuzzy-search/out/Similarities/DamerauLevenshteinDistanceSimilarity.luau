--[[
	*
	 * Normalizes Damerau-Levenshtein edit distance (0–1).
	 
]]
local function DamerauLevenshteinDistanceSimilarity(term, query)
	local maxLen = math.max(#term, #query)
	if maxLen == 0 then
		return 1
	end
	local distance = Scores.DamerauLevenshteinDistance(term, query)
	return 1 - distance / maxLen
end
