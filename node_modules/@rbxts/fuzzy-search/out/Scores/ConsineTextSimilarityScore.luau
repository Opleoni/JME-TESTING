	local _callback = function(acc, token)
		local _acc = acc
		local _exp = token
		local _acc_1 = acc
		local _token = token
		local _condition = _acc_1[_token]
		if _condition == nil then
			_condition = 0
		end
		_acc[_exp] = _condition + 1
		return acc
	end
	for _i = 1, #tokens do
		_result = _callback(_result, tokens[_i], _i - 1, tokens)
	end
	-- ▲ ReadonlyArray.reduce ▲
	return _result
end
--[[
	*
	 * Builds a combined vocabulary from two term frequency maps.
	 
]]
local function BuildVocabulary(tf1, tf2)
