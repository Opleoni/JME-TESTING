	local str1_hash = table.create(len1)
	local str2_hash = table.create(len2)
	for i = 0, len1 - 1 do
		for j = math.max(0, i - window), math.min(len2, i + window + 1) - 1 do
			if not str1_hash[i + 1] and not str2_hash[j + 1] and CharAt(string_1, i) == CharAt(string_2, j) then
				m += 1
