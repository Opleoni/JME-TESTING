--[[
	*
	 * Simple English listing of items using commas and "and".
	 *
	 * @param strings The strings to combine.
	 * @returns The combined string.
	 
]]
local function combineHumanReadable(...)
	local strings = { ... }
	local label = ""
	local i = 1
	local size = #strings
	for _, c in strings do
		if c == "" then
			size -= 1
			continue
		end
		label ..= c
		if i < size then
			label ..= ", "
		end
		i += 1
	end
	return label
end
