		return nil
	end
	if object:IsA("UIStroke") then
		object.Color = color
	elseif object:IsA("GuiObject") then
		object.BackgroundColor3 = color
	end
	if deepColor then
		if object:IsA("TextLabel") then
			object.TextColor3 = color
		end
	end
end
--[[
