	 * @param area The BasePart defining the area.
	 * @returns An array of Humanoids in the area.
	 
]]
local function getHumanoidsInArea(humanoids, area)
	area.Touched:Connect(function() end)
	local inArea = {}
	for _, otherPart in area:GetTouchingParts() do
		if otherPart.Parent then
			local humanoid = otherPart.Parent:FindFirstChildOfClass("Humanoid")
